{
  "name": "RC Wallet External",
  "short_name": "RC Wallet",
  "description": "Wallet externa sin custodia para administrar la misma direccion EVM en World Chain y redes compatibles.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#070a0e",
  "theme_color": "#070a0e",
  "categories": ["finance", "utilities"],
  "icons": [
    {
      "src": "/rc-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/rc-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/rc-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
